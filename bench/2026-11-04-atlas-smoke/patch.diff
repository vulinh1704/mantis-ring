diff --git a/css/table.css b/css/table.css
index d4ba7ce..e1fe0b7 100644
--- a/css/table.css
+++ b/css/table.css
@@ -1,6 +1,20 @@
-.invoices { width: 100%; border-collapse: collapse; font-size: 15px; }
+/* Room for the invoice rows, which the script fills in after load,
+   so the content below does not jump. */
+.table-wrap { overflow-x: auto; min-height: 240px; }
+.invoices { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 15px; }
+.invoices th:nth-child(1), .invoices td:nth-child(1) { width: 18%; }
+.invoices th:nth-child(2), .invoices td:nth-child(2) { width: 30%; }
+.invoices th:nth-child(3), .invoices td:nth-child(3) { width: 17%; }
+.invoices th:nth-child(4), .invoices td:nth-child(4) { width: 19%; }
+.invoices th:nth-child(5), .invoices td:nth-child(5) { width: 16%; }
 .invoices th, .invoices td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); white-space: nowrap; }
 .invoices th { font-size: 13px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .04em; }
 .status { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; }
 .status--paid { color: var(--ok); border: 1px solid var(--ok); }
 .status--overdue { color: var(--danger); border: 1px solid var(--danger); }
+
+/* On narrow screens let cells wrap so the table fits the viewport. */
+@media (max-width: 640px) {
+  .invoices th, .invoices td { white-space: normal; padding: 10px 8px; }
+  .invoices td.customer { overflow-wrap: anywhere; }
+}
